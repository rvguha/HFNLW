# Ranking and embeddings run through OpenRouter. Without a key the server still
# starts and serves deterministic offline embeddings plus BM25, which is enough
# to exercise retrieval but not the ranked, explained answers.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Decontextualisation and answer generation. gpt-oss-120b is both larger
# and ~10x cheaper than gpt-4.1-mini ($0.04/$0.17 against $0.40/$1.60).
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_RANKING_MODEL=openai/gpt-oss-20b
OPENROUTER_RANKING_PROVIDER_SORT=throughput
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_TITLE=ask-hf-hub

ASKHUB_HOST=127.0.0.1
ASKHUB_PORT=8000
ASKHUB_DATA_DIR=data

# Which schema.org keys reach the ranking model. Corpus-shaped: a product
# catalog needs offers and eligibleRegion, a model catalog needs about and
# subjectOf. Leave unset to use the defaults in config.py.
ASKHUB_RANKING_FIELDS=

# Ceilings on the per-request retrieval_count and ranking_count overrides. A
# wide retrieval judged by an expensive model is what an evaluation wants and
# what an abusive request wants; the server decides the limit.
ASKHUB_MAX_RETRIEVAL_COUNT=200
ASKHUB_MAX_RANKING_COUNT=200
